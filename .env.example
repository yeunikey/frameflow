COMPOSE_PROJECT_NAME=frameflow
HTTP_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

POSTGRES_USER=frameflow_admin
POSTGRES_DB=frameflow_control
POSTGRES_PASSWORD=replace-with-local-admin-password
IDENTITY_DB=frameflow_identity
IDENTITY_DB_USER=frameflow_identity
IDENTITY_DB_PASSWORD=replace-with-identity-password
DOCUMENT_DB=frameflow_document
DOCUMENT_DB_USER=frameflow_document
DOCUMENT_DB_PASSWORD=replace-with-document-password
WORKSPACE_DB=frameflow_workspace
WORKSPACE_DB_USER=frameflow_workspace
WORKSPACE_DB_PASSWORD=replace-with-workspace-password
REDIS_PASSWORD=replace-with-redis-password

MINIO_ROOT_USER=frameflow_minio_root
MINIO_ROOT_PASSWORD=replace-with-minio-root-password
MINIO_APP_USER=frameflow_storage
MINIO_APP_PASSWORD=replace-with-storage-password
S3_REGION=us-east-1
S3_BUCKET_DOCUMENTS=frameflow-documents
S3_BUCKET_PAGES=frameflow-pages
S3_BUCKET_EXPORTS=frameflow-exports
S3_BUCKET_MODELS=frameflow-models

NEXT_PUBLIC_API_BASE_URL=/v1
